{
  "name": "packetlens",
  "version": "0.1.0",
  "description": "A lightweight PCAP and PCAPNG network traffic analyser for security investigations.",
  "type": "module",
  "bin": {
    "packetlens": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["pcap", "pcapng", "network-analysis", "cybersecurity", "forensics", "cli"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
